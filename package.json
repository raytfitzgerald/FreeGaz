{
  "name": "freegaz",
  "productName": "FreeGaz",
  "version": "0.5.0",
  "description": "A data-obsessed indoor cycling trainer for macOS: ERG/SIM control, workout builder, FTP tests, FIT export, Strava upload, and optional AI coaching.",
  "author": "Ray Fitzgerald (https://github.com/raytfitzgerald)",
  "license": "MIT",
  "homepage": "https://github.com/raytfitzgerald/FreeGaz",
  "repository": {
    "type": "git",
    "url": "https://github.com/raytfitzgerald/FreeGaz.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts --port 5198",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --mac --publish never",
    "dist:signed": "node scripts/dist-signed.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "selftest:packaged": "FREEGAZ_SELFTEST=1 FREEGAZ_TEST=1 FREEGAZ_USER_DATA=$(mktemp -d) release/$npm_package_version/mac-arm64/FreeGaz.app/Contents/MacOS/FreeGaz",
    "postinstall": "install-electron",
    "icon": "electron scripts/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@markw65/fit-file-writer": "^0.2.0",
    "@tanstack/react-router": "^1.170.40",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "fit-file-parser": "^6.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "ollama": "^0.6.4",
    "openai": "^7.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "uplot": "^1.6.32",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@garmin/fitsdk": "^21.217.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
